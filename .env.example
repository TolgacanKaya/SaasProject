# DJANGO GÜVENLİK AYARLARI
DJANGO_SECRET_KEY='django-insecure-your-secret-key-goes-here'
DJANGO_DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# E-POSTA AYARLARI (GMAIL SMTP veya Diğerleri)
EMAIL_HOST_USER='your-email@gmail.com'
EMAIL_HOST_PASSWORD='your-gmail-app-password'

# GOOGLE OAUTH AYARLARI (Calendar & Giriş Entegrasyonları)
GOOGLE_CLIENT_ID='your-google-client-id'
GOOGLE_CLIENT_SECRET='your-google-client-secret'

# IYZICO ÖDEME AYARLARI
IYZICO_API_KEY='sandbox-your-iyzico-api-key'
IYZICO_SECRET_KEY='sandbox-your-iyzico-secret-key'
IYZICO_BASE_URL='sandbox-api.iyzipay.com'

# SPOTIFY API ENTEGRASYONU
SPOTIFY_CLIENT_ID='your-spotify-client-id'
SPOTIFY_CLIENT_SECRET='your-spotify-client-secret'

# VERİTABANI AYARLARI (PostgreSQL)
DB_NAME='trandevu_db'
DB_USER='postgres'
DB_PASSWORD='your-db-password'
DB_HOST='127.0.0.1'
DB_PORT='5432'

# GÜVENLİK & ŞİFRELEME (Model alanlarını şifrelemek için 32-byte Fernet key)
FIELD_ENCRYPTION_KEY='your-32-byte-fernet-key-here'
